{
  "name": "near-sdk-as-example-cross-contract-simple",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:test-contracts": "near-as build test-contracts/hello-near/contract.ts --out test-contracts/hello-near/build/contract.wasm",
    "build": "npm run build:test-contracts && near-as build contract.ts --out build/contract.wasm",
    "test:wasm": "node --test wasm.test.mjs",
    "test:sandbox": "node --test sandbox.test.mjs",
    "test": "npm run build && npm run test:wasm && npm run test:sandbox"
  },
  "dependencies": { "near-sdk-as": "0.1.0-alpha.0" },
  "devDependencies": {
    "assemblyscript": "0.28.19",
    "near-api-js": "7.2.0",
    "near-sandbox": "^0.3.0"
  },
  "engines": { "node": ">=22.22.2" }
}
