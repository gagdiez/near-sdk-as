{
  "name": "near-sdk-as-example-cross-contract-advanced",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:hello": "near-as build test-contracts/hello-near/src/contract.ts --out test-contracts/hello-near/build/contract.wasm",
    "build:counter": "near-as build test-contracts/counters/src/contract.ts --out test-contracts/counters/build/contract.wasm",
    "build:guest-book": "near-as build test-contracts/guest-book/src/contract.ts --out test-contracts/guest-book/build/contract.wasm",
    "build:test-contracts": "npm run build:hello && npm run build:counter && npm run build:guest-book",
    "build": "npm run build:test-contracts && near-as build src/contract.ts --out build/contract.wasm",
    "test:wasm": "node --test test/wasm.test.mjs",
    "test:sandbox": "node --test test/sandbox.test.mjs",
    "test": "npm run build && npm run test:wasm && npm run test:sandbox"
  },
  "dependencies": { "near-sdk-as": "0.1.0-alpha.0" },
  "devDependencies": {
    "assemblyscript": "0.28.19",
    "near-api-js": "7.2.0",
    "near-sandbox": "^0.3.0"
  },
  "engines": { "node": ">=22.22.2" }
}
